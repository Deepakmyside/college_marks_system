generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  role         String
  markSessions MarkSession[]
}

model Branch {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  students     Student[]
  subjects     Subject[]
  markSessions MarkSession[]
}

model Semester {
  id           Int           @id @default(autoincrement())
  number       Int           @unique
  students     Student[]
  subjects     Subject[]
  markSessions MarkSession[]
}

model Student {
  id      Int    @id @default(autoincrement())
  uid     String @unique
  name    String
  batch   String
  section String

  branchId   Int
  semesterId Int

  branch   Branch   @relation(fields: [branchId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  assessments Assessment[]
}

model Subject {
  id           Int           @id @default(autoincrement())
  name         String
  branchId     Int
  semesterId   Int
  markSessions MarkSession[]

  branch Branch @relation(fields: [branchId], references: [id])

  semester Semester @relation(fields: [semesterId], references: [id])
}

model MarkSession {
  id         Int      @id @default(autoincrement())
  teacherId  Int
  subjectId  Int
  branchId   Int
  semesterId Int
  section    String
  date       DateTime

  teacher  User     @relation(fields: [teacherId], references: [id])
  subject  Subject  @relation(fields: [subjectId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  assessments Assessment[]

  @@unique([subjectId, branchId, semesterId, section, date])
}

model Assessment {
  id            Int @id @default(autoincrement())
  markSessionId Int
  studentId     Int

  marks Float

  markSession MarkSession @relation(fields: [markSessionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([markSessionId, studentId])
}
