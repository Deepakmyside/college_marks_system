generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int                        @id @default(autoincrement())
  name         String
  email        String                     @unique
  passwordHash String
  role         String
  markSessions MarkSession[]
  assignments  TeacherSubjectAssignment[]
}

model Branch {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  students     Student[]
  subjects     Subject[]
  markSessions MarkSession[]
}

model Semester {
  id     Int @id @default(autoincrement())
  number Int @unique

  subjects     Subject[]
  markSessions MarkSession[]
}

model Student {
  id      Int    @id @default(autoincrement())
  uid     String @unique
  name    String
  batch   String
  section String

  branchId Int

  branch Branch @relation(fields: [branchId], references: [id])

  assessments Assessment[]

  @@index([branchId, batch, section])
}

model Subject {
  id         Int    @id @default(autoincrement())
  name       String
  branchId   Int
  semesterId Int
  branch     Branch @relation(fields: [branchId], references: [id])

  semester     Semester      @relation(fields: [semesterId], references: [id])
  markSessions MarkSession[]

  TeacherSubjectAssignment TeacherSubjectAssignment[]

  @@unique([name, branchId, semesterId])
}

model MarkSession {
  id               Int      @id @default(autoincrement())
  teacherId        Int
  subjectId        Int
  branchId         Int
  semesterId       Int
  batch            String
  section          String
  date             DateTime
  academicPeriodId Int?
  assignmentId     Int?

  teacher        User                      @relation(fields: [teacherId], references: [id])
  subject        Subject                   @relation(fields: [subjectId], references: [id])
  branch         Branch                    @relation(fields: [branchId], references: [id])
  semester       Semester                  @relation(fields: [semesterId], references: [id])
  academicPeriod AcademicPeriod?           @relation(fields: [academicPeriodId], references: [id])
  assignment     TeacherSubjectAssignment? @relation(fields: [assignmentId], references: [id])

  assessments Assessment[]

  @@unique([subjectId, branchId, semesterId, batch, section, date])
}

model Assessment {
  id            Int @id @default(autoincrement())
  markSessionId Int
  studentId     Int

  communicationSkills Float?
  technicalSkills     Float?
  behaviouralSkills   Float?
  softSkills          Float?

  markSession MarkSession @relation(fields: [markSessionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([markSessionId, studentId])
}

model AcademicPeriod {
  id           Int      @id @default(autoincrement())
  academicYear String
  term         String
  startDate    DateTime
  endDate      DateTime

  assignments  TeacherSubjectAssignment[]
  markSessions MarkSession[]

  @@unique([academicYear, term])
}

model TeacherSubjectAssignment {
  id               Int    @id @default(autoincrement())
  teacherId        Int
  subjectId        Int
  academicPeriodId Int
  batch            String
  section          String

  teacher        User            @relation(fields: [teacherId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  AcademicPeriod AcademicPeriod? @relation(fields: [academicPeriodId], references: [id])
  markSessions   MarkSession[]

  // One teacher assigned to a subject group for a given period.
  @@unique([teacherId, subjectId, academicPeriodId, batch, section])
  // One teacher/group assignment for a subject in a given section and period.
  @@unique([subjectId, academicPeriodId, batch, section])
  @@index([teacherId, academicPeriodId])
}
