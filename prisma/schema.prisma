generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  username     String @unique
  passwordHash String
  role         String

  markSessions MarkSession[]
  assignments  TeacherSubjectAssignment[]
}

model Branch {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  students     Student[]
  subjects     Subject[]
  markSessions MarkSession[]
}

model Semester {
  id           Int           @id @default(autoincrement())
  number       Int           @unique
  subjects     Subject[]
  markSessions MarkSession[]
}

model Student {
  id      Int    @id @default(autoincrement())
  uid     String @unique
  name    String
  batch   String
  section String

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  groupMemberships SubjectGroupStudent[]
  assessments      Assessment[]

  @@index([branchId, batch, section])
}

model Subject {
  id         Int    @id @default(autoincrement())
  name       String
  branchId   Int
  semesterId Int

  branch       Branch                     @relation(fields: [branchId], references: [id])
  semester     Semester                   @relation(fields: [semesterId], references: [id])
  groups       SubjectGroup[]
  assignments  TeacherSubjectAssignment[]
  markSessions MarkSession[]

  @@unique([name, branchId, semesterId])
}

model AcademicPeriod {
  id           Int      @id @default(autoincrement())
  academicYear String
  term         String
  startDate    DateTime
  endDate      DateTime

  assignments      TeacherSubjectAssignment[]
  groups           SubjectGroup[]
  groupMemberships SubjectGroupStudent[]
  markSessions     MarkSession[]

  @@unique([academicYear, term])
}

model SubjectGroup {
  id               Int    @id @default(autoincrement())
  name             String
  subjectId        Int
  academicPeriodId Int
  batch            String
  section          String

  subject        Subject        @relation(fields: [subjectId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])

  students           SubjectGroupStudent[]
  teacherAssignments TeacherGroupAssignment[]
  markSessions       MarkSession[]

  @@unique([subjectId, academicPeriodId, batch, section])
}

model SubjectGroupStudent {
  id               Int @id @default(autoincrement())
  studentId        Int
  subjectGroupId   Int
  academicPeriodId Int

  student        Student        @relation(fields: [studentId], references: [id])
  subjectGroup   SubjectGroup   @relation(fields: [subjectGroupId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])

  // A student can belong to only one group per academic period.
  @@unique([studentId, academicPeriodId])
  @@index([subjectGroupId])
}

model TeacherSubjectAssignment {
  id               Int @id @default(autoincrement())
  teacherId        Int
  subjectId        Int
  academicPeriodId Int

  teacher        User           @relation(fields: [teacherId], references: [id])
  subject        Subject        @relation(fields: [subjectId], references: [id])
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id])

  groups       TeacherGroupAssignment[]
  markSessions MarkSession[]

  // One distinct subject per teacher per academic period.
  @@unique([teacherId, academicPeriodId])
}

model TeacherGroupAssignment {
  id                         Int @id @default(autoincrement())
  teacherSubjectAssignmentId Int
  subjectGroupId             Int @unique

  teacherSubjectAssignment TeacherSubjectAssignment @relation(fields: [teacherSubjectAssignmentId], references: [id])
  subjectGroup             SubjectGroup             @relation(fields: [subjectGroupId], references: [id])
}

model MarkSession {
  id               Int      @id @default(autoincrement())
  teacherId        Int
  subjectId        Int
  branchId         Int
  semesterId       Int
  academicPeriodId Int?
  assignmentId     Int?
  subjectGroupId   Int?
  batch            String
  section          String
  date             DateTime

  teacher        User                      @relation(fields: [teacherId], references: [id])
  subject        Subject                   @relation(fields: [subjectId], references: [id])
  branch         Branch                    @relation(fields: [branchId], references: [id])
  semester       Semester                  @relation(fields: [semesterId], references: [id])
  academicPeriod AcademicPeriod?           @relation(fields: [academicPeriodId], references: [id])
  assignment     TeacherSubjectAssignment? @relation(fields: [assignmentId], references: [id])
  subjectGroup   SubjectGroup?             @relation(fields: [subjectGroupId], references: [id])

  assessments Assessment[]

  @@unique([subjectId, branchId, semesterId, batch, section, date])
  @@index([teacherId, subjectId])
}

model Assessment {
  id            Int @id @default(autoincrement())
  markSessionId Int
  studentId     Int

  communicationSkills Float?
  technicalSkills     Float?
  behaviouralSkills   Float?
  softSkills          Float?

  markSession MarkSession @relation(fields: [markSessionId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([markSessionId, studentId])
}
